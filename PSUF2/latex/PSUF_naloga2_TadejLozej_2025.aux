\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Na grafu je prikazana normirana kumulativna vsota lastnih vrednosti (modra) ter lastne vrednosti (rdeča), ki jih dobimo z danim setom podatkov ter PCA metodo. Devetdeset odstotkov variance dosežemo že z zgolj 101 PCA koordinatami.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:lastne_vrednosti}{{2}{3}{Na grafu je prikazana normirana kumulativna vsota lastnih vrednosti (modra) ter lastne vrednosti (rdeča), ki jih dobimo z danim setom podatkov ter PCA metodo. Devetdeset odstotkov variance dosežemo že z zgolj 101 PCA koordinatami}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Diagonalni grafi prikazujejo porazdelitev spektrov po prvih treh glavnih PCA koordinatah. Izvendiagonalni grafi prikazujejo dvodimenzionalne porazdelitve spektrov po dveh izmed prvih treh glavnih PCA koordinatah. Na spodnji diagonali so z zvezdami različnih barv prikazani tudi različni tipi spektrov. Na zgornji diagonali ter spodnjem delu histogramov so z barvnim gradientom prikazane znane efektivne temperature zvezd.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:PCA1}{{3}{4}{Diagonalni grafi prikazujejo porazdelitev spektrov po prvih treh glavnih PCA koordinatah. Izvendiagonalni grafi prikazujejo dvodimenzionalne porazdelitve spektrov po dveh izmed prvih treh glavnih PCA koordinatah. Na spodnji diagonali so z zvezdami različnih barv prikazani tudi različni tipi spektrov. Na zgornji diagonali ter spodnjem delu histogramov so z barvnim gradientom prikazane znane efektivne temperature zvezd}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Diagonalni grafi prikazujejo porazdelitev spektrov po prvih treh glavnih PCA koordinatah. Izvendiagonalni grafi prikazujejo dvodimenzionalne porazdelitve spektrov po dveh izmed prvih treh glavnih PCA koordinatah. Na spodnji diagonali ter spodnjem delu histogramov so z barvnim gradientom prikazane znani gravitacijski pospeški zvezd. Na zgornji diagonali ter zgornjem delu histogramov so z barvnim gradientom prikazane znane kovinskosti zvezd.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:PCA2}{{4}{5}{Diagonalni grafi prikazujejo porazdelitev spektrov po prvih treh glavnih PCA koordinatah. Izvendiagonalni grafi prikazujejo dvodimenzionalne porazdelitve spektrov po dveh izmed prvih treh glavnih PCA koordinatah. Na spodnji diagonali ter spodnjem delu histogramov so z barvnim gradientom prikazane znani gravitacijski pospeški zvezd. Na zgornji diagonali ter zgornjem delu histogramov so z barvnim gradientom prikazane znane kovinskosti zvezd}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Porazdelitev spektrov v odvisnosti od treh pomembnih fizikalnih količin ter treh glavnih PCA koordinat. V okvirčkih sta izračunana Pearsonova ter Spearmanova korelacija.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:korelacije1}{{5}{6}{Porazdelitev spektrov v odvisnosti od treh pomembnih fizikalnih količin ter treh glavnih PCA koordinat. V okvirčkih sta izračunana Pearsonova ter Spearmanova korelacija}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces PEarsonov in Spearmanov korelacijski koeficient med tremi pomembnimi fizikalnimi količinami ter 101 glavnimi PCA koordinatami.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:korelacije2}{{6}{6}{PEarsonov in Spearmanov korelacijski koeficient med tremi pomembnimi fizikalnimi količinami ter 101 glavnimi PCA koordinatami}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Diagonalna grafa prikazujeta porazdelitev spektrov po tretji ter sedmi PCA koordinati. Zgoraj desno je prikazana dvodimenzionalna porazdelitev spektrov po tretji ter sedmi PCA koordinati. Spodaj levo je prikazana porazdelitev spektrov po kovinskosti ter sedmi PCA koordinati. V okvirčku sta podana tudi Pearsonov ter Spearmanov korelacijski koeficient.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:PCA3}{{7}{7}{Diagonalna grafa prikazujeta porazdelitev spektrov po tretji ter sedmi PCA koordinati. Zgoraj desno je prikazana dvodimenzionalna porazdelitev spektrov po tretji ter sedmi PCA koordinati. Spodaj levo je prikazana porazdelitev spektrov po kovinskosti ter sedmi PCA koordinati. V okvirčku sta podana tudi Pearsonov ter Spearmanov korelacijski koeficient}{figure.caption.8}{}}
