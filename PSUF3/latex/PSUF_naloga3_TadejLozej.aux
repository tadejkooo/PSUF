\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Povprečne funkcije izgube mreže z dvema skritima slojema v odvisnosti od števila Epochov za različne aktivacijske funkcije nevronov. Prikazani sta trening ter validacijska funkcija izgube. Prav tako je prikazana povprečna MAE vrednost med testno množico in napovedjo. Uporabljeni so zgolj podatki intenzitete pri $\lambda = 500 \, \text  {nm}$.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:mreze1}{{4}{4}{Povprečne funkcije izgube mreže z dvema skritima slojema v odvisnosti od števila Epochov za različne aktivacijske funkcije nevronov. Prikazani sta trening ter validacijska funkcija izgube. Prav tako je prikazana povprečna MAE vrednost med testno množico in napovedjo. Uporabljeni so zgolj podatki intenzitete pri $\lambda = 500 \, \text {nm}$}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Povprečne funkcije izgube nevronskih mrež različnih geometrij. Na sliki so prikazane povprečne funkcije izgube trening ter validacijske množice. S črtkano zeleno črto je prikazana povprečna vrednost MAE med napovedjo ter testno množico. V okvirčku sta zapisana MAE ter MSE med napovedjo ter testno množico.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:mreze2}{{5}{5}{Povprečne funkcije izgube nevronskih mrež različnih geometrij. Na sliki so prikazane povprečne funkcije izgube trening ter validacijske množice. S črtkano zeleno črto je prikazana povprečna vrednost MAE med napovedjo ter testno množico. V okvirčku sta zapisana MAE ter MSE med napovedjo ter testno množico}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Primerjava Napovedanih ter pravih vrednosti. Z rdečo ter zeleno črtkano črto sta podani območji za 5\% ter 10\% napako.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:rezultati1}{{6}{6}{Primerjava Napovedanih ter pravih vrednosti. Z rdečo ter zeleno črtkano črto sta podani območji za 5\% ter 10\% napako}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Zašumljeni podaki}{7}{subsection.3.2}\protected@file@percent }
